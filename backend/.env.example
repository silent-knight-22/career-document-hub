# Career Document Hub — backend environment variables (example)
# Copy to backend/.env or export in your shell. Never commit real values.

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=career_document_hub

# CORS — comma-separated origins for the Vite React app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional server port
SERVER_PORT=8080

# Phase 2 — JWT signing secret (leave unset/empty until Phase 2)
JWT_SECRET=

# Optional Spring profile (loads application-local.properties when set to "local")
# SPRING_PROFILES_ACTIVE=local
