# Career Document Hub — frontend environment
# Copy to `.env` / `.env.local` for local overrides. Restart Vite after changes.
# Never put secrets (Groq keys, JWT secrets) in VITE_* — they ship to the browser.

# Spring Boot API base (include /api/v1). Leave empty in production to use relative "/api/v1".
VITE_API_URL=http://localhost:8080/api/v1

# Network tuning (optional)
# VITE_REQUEST_TIMEOUT_MS=30000
# VITE_REQUEST_RETRIES=2

# Set to "false" only if AI is fully proxied by the backend (future).
# VITE_CLIENT_SIDE_AI=true
